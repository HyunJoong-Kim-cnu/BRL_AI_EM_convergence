% =========================================================================
% Advanced Triangular Mesh Generator for Numerical Analysis (MoM / FEM)
% =========================================================================
% BRL_인공지능-전자파 융합 해석
%
% Description:
%   Generates a high-quality triangular surface mesh on a rectangular plate
%   of size Lx x Ly divided into m x n grid cells. Each cell is split diagonally.
%
% Key Features:
%   1. Flexible diagonal splitting patterns ('/', '', 'alternating', 'cross')
%   2. Calculates Node coordinates (X, Y, Z), Tri-connectivity matrix
%   3. Patch Centroids, Surface Areas, Unit Normal Vectors
%   4. Edge topology extraction (Internal edges & Boundary edges for RWG / MoM)
%   5. Triangle aspect ratio & mesh quality evaluation
%   6. Comprehensive 3D visualization and diagnostic reporting
% =========================================================================

clear; clc; close all;

% STREAMING_CHUNK:Setting up simulation parameters and plate geometry...

% --- 1. Plate Dimensions & Mesh Division Parameters ---
Lx = 1.0;            % Plate length along X-axis (meters)
Ly = 0.8;            % Plate width along Y-axis (meters)
m  = 10;             % Number of cell divisions along X-axis
n  = 8;              % Number of cell divisions along Y-axis

% Diagonal split pattern selection:
% '/'            : Main diagonal split (bottom-left to top-right)
% ''            : Anti-diagonal split (top-left to bottom-right)
% 'alternating'  : Alternating diagonal direction across cells
% 'cross'        : Union-jack / Cross split (4 triangles per cell with center node)
diag_pattern = '/';

fprintf('=\n');
fprintf('  BRL Computational Electromagnetics Mesh Generator    \n');
fprintf('=\n');
fprintf(' Plate Dimensions  : %.3f m x %.3f m\n', Lx, Ly);
fprintf(' Grid Subdivision  : %d x %d cells\n', m, n);
fprintf(' Diagonal Pattern  : %s\n', diag_pattern);

% STREAMING_CHUNK:Generating 3D node coordinates...

% --- 2. Node Generation ---
x_grid = linspace(0, Lx, m + 1);
y_grid = linspace(0, Ly, n + 1);
[Xg, Yg] = meshgrid(x_grid, y_grid);

if strcmp(diag_pattern, 'cross')
% For cross pattern, center nodes are added to each cell
grid_nodes = [Xg(:), Yg(:), zeros(numel(Xg), 1)];
num_grid_nodes = size(grid_nodes, 1);

cell_centers = zeros(m * n, 3);
for i = 1:m
    for j = 1:n
        xc = (x_grid(i) + x_grid(i+1)) / 2;
        yc = (y_grid(j) + y_grid(j+1)) / 2;
        cell_idx = (i - 1) * n + j;
        cell_centers(cell_idx, :) = [xc, yc, 0];
    end
end
nodes = [grid_nodes; cell_centers];


else
% Standard grid nodes (m+1) x (n+1)
nodes = [Xg(:), Yg(:), zeros(numel(Xg), 1)];
end

num_nodes = size(nodes, 1);

% STREAMING_CHUNK:Building element connectivity matrix...

% --- 3. Triangular Connectivity Matrix ---
if strcmp(diag_pattern, 'cross')
num_triangles = 4 * m * n;
elements = zeros(num_triangles, 3);
elem_idx = 1;

for i = 1:m
    for j = 1:n
        % Corner node indices for cell (i, j)
        n1 = (i - 1) * (n + 1) + j;
        n2 = i * (n + 1) + j;
        n3 = i * (n + 1) + (j + 1);
        n4 = (i - 1) * (n + 1) + (j + 1);
        
        % Center node index
        nc = num_grid_nodes + (i - 1) * n + j;
        
        % 4 Triangles per quad cell
        elements(elem_idx,     :) = [n1, n2, nc];
        elements(elem_idx + 1, :) = [n2, n3, nc];
        elements(elem_idx + 2, :) = [n3, n4, nc];
        elements(elem_idx + 3, :) = [n4, n1, nc];
        elem_idx = elem_idx + 4;
    end
end


else
num_triangles = 2 * m * n;
elements = zeros(num_triangles, 3);
elem_idx = 1;

for i = 1:m
    for j = 1:n
        n1 = (i - 1) * (n + 1) + j;
        n2 = i * (n + 1) + j;
        n3 = i * (n + 1) + (j + 1);
        n4 = (i - 1) * (n + 1) + (j + 1);
        
        current_diag = diag_pattern;
        if strcmp(diag_pattern, 'alternating')
            if mod(i + j, 2) == 0
                current_diag = '/';
            else
                current_diag = '\';
            end
        end
        
        if strcmp(current_diag, '/')
            elements(elem_idx,     :) = [n1, n2, n3];
            elements(elem_idx + 1, :) = [n1, n3, n4];
        else
            elements(elem_idx,     :) = [n1, n2, n4];
            elements(elem_idx + 1, :) = [n2, n3, n4];
        end
        elem_idx = elem_idx + 2;
    end
end


end

% STREAMING_CHUNK:Calculating geometric properties of triangular patches...

% --- 4. Geometry Computations (Centroids, Normals, Areas) ---
patch_centers = zeros(num_triangles, 3);
patch_normals = zeros(num_triangles, 3);
patch_areas   = zeros(num_triangles, 1);

for t = 1:num_triangles
v1 = nodes(elements(t, 1), :);
v2 = nodes(elements(t, 2), :);
v3 = nodes(elements(t, 3), :);

% Centroid calculation
patch_centers(t, :) = (v1 + v2 + v3) / 3;

% Cross product of edge vectors
e12 = v2 - v1;
e13 = v3 - v1;
cross_vec = cross(e12, e13);

vec_norm = norm(cross_vec);
patch_areas(t) = 0.5 * vec_norm;

% Unit surface normal vector (+Z direction for flat plate)
if vec_norm > 0
    patch_normals(t, :) = cross_vec / vec_norm;
else
    patch_normals(t, :) = [0, 0, 1];
end


end

% STREAMING_CHUNK:Extracting unique edges and boundary conditions...

% --- 5. Edge Topology Extraction for MoM / FEM Basis Setup ---
all_edges = [elements(:, [1, 2]); elements(:, [2, 3]); elements(:, [3, 1])];
sorted_edges = sort(all_edges, 2);
[unique_edges, ~, edge_ic] = unique(sorted_edges, 'rows');

num_edges = size(unique_edges, 1);
edge_counts = accumarray(edge_ic, 1);

interior_edges = unique_edges(edge_counts == 2, :);
boundary_edges = unique_edges(edge_counts == 1, :);

num_interior_edges = size(interior_edges, 1);
num_boundary_edges = size(boundary_edges, 1);

% STREAMING_CHUNK:Evaluating mesh quality and triangle aspect ratios...

% --- 6. Mesh Quality Metrics ---
aspect_ratios = zeros(num_triangles, 1);
min_angles    = zeros(num_triangles, 1);

for t = 1:num_triangles
v1 = nodes(elements(t, 1), :);
v2 = nodes(elements(t, 2), :);
v3 = nodes(elements(t, 3), :);

a = norm(v2 - v3);
b = norm(v3 - v1);
c = norm(v1 - v2);
s = (a + b + c) / 2;
area = patch_areas(t);

% Inradius (r) and Circumradius (R)
r_in = area / s;
R_circ = (a * b * c) / (4 * area);

% Normalized Aspect Ratio (1.0 = Equilateral Triangle)
aspect_ratios(t) = R_circ / (2 * r_in);

% Internal Angles (Degrees)
cosA = max(-1, min(1, (b^2 + c^2 - a^2) / (2 * b * c)));
cosB = max(-1, min(1, (a^2 + c^2 - b^2) / (2 * a * c)));
cosC = max(-1, min(1, (a^2 + b^2 - c^2) / (2 * a * b)));
angles = acosd([cosA, cosB, cosC]);
min_angles(t) = min(angles);


end

% STREAMING_CHUNK:Plotting 3D triangular mesh and normal vectors...

% --- 7. Main Visualization: 3D Surface Patch Mesh ---
fig1 = figure('Name', 'Flat Plate Triangular Mesh Model', 'Color', [1 1 1], ...
'Position', [80, 80, 950, 700]);

% Render surface patches
hp = patch('Faces', elements, 'Vertices', nodes, ...
'FaceVertexCData', patch_areas, ...
'FaceColor', 'flat', ...
'EdgeColor', [0.15 0.15 0.25], ...
'LineWidth', 1.1, ...
'FaceAlpha', 0.90);

hold on;

% Highlight nodes
plot3(nodes(:, 1), nodes(:, 2), nodes(:, 3), 'ro', ...
'MarkerFaceColor', [0.85 0.1 0.1], ...
'MarkerEdgeColor', 'k', ...
'MarkerSize', 4.5, ...
'DisplayName', 'Mesh Nodes');

% Plot Normal Vectors at centroids
quiver3(patch_centers(:, 1), patch_centers(:, 2), patch_centers(:, 3), ...
patch_normals(:, 1), patch_normals(:, 2), patch_normals(:, 3), 0.35, ...
'Color', [0.9 0.2 0.0], 'LineWidth', 1.2, 'MaxHeadSize', 0.6, ...
'DisplayName', 'Unit Normals (\hat{n})');

% Axis settings
xlabel('X Axis (m)', 'FontSize', 11, 'FontWeight', 'bold');
ylabel('Y Axis (m)', 'FontSize', 11, 'FontWeight', 'bold');
zlabel('Z Axis (m)', 'FontSize', 11, 'FontWeight', 'bold');
title(sprintf('Flat Plate Triangular Surface Mesh (m=%d, n=%d, Patches=%d)', ...
m, n, num_triangles), 'FontSize', 12, 'FontWeight', 'bold');

cb1 = colorbar;
ylabel(cb1, 'Patch Area (m^2)', 'FontSize', 10, 'FontWeight', 'bold');
colormap(parula);
axis equal; grid on; box on;
view(32, 40);
legend('Location', 'northeast', 'FontSize', 10);

% STREAMING_CHUNK:Displaying mesh quality map and statistics...

% --- 8. Quality Inspection Plots ---
fig2 = figure('Name', 'Mesh Quality Inspection', 'Color', [1 1 1], ...
'Position', [1050, 80, 800, 700]);

subplot(2, 1, 1);
hp_q = patch('Faces', elements, 'Vertices', nodes, ...
'FaceVertexCData', aspect_ratios, ...
'FaceColor', 'flat', ...
'EdgeColor', [0.2 0.2 0.2], ...
'LineWidth', 0.8);
axis equal; grid on; box on;
title('Triangle Aspect Ratio Distribution (Ideal = 1.0)', 'FontSize', 11, 'FontWeight', 'bold');
xlabel('X (m)'); ylabel('Y (m)');
cb2 = colorbar;
ylabel(cb2, 'Aspect Ratio', 'FontSize', 10);
colormap(gca, jet);

subplot(2, 1, 2);
histogram(min_angles, 15, 'FaceColor', [0.2 0.6 0.8], 'EdgeColor', 'k');
grid on;
title('Minimum Interior Angle Distribution', 'FontSize', 11, 'FontWeight', 'bold');
xlabel('Minimum Angle (Degrees)');
ylabel('Element Count');

% STREAMING_CHUNK:Printing comprehensive numerical summary...

% --- 9. Summary & Diagnostic Output ---
total_calc_area = sum(patch_areas);
exact_area      = Lx * Ly;
area_error_pct  = abs(total_calc_area - exact_area) / exact_area * 100;

fprintf('\n-------------------------------------------------------\n');
fprintf('                Mesh Generation Summary                \n');
fprintf('-------------------------------------------------------\n');
fprintf(' Total Nodes           : %d\n', num_nodes);
fprintf(' Total Triangular Elements: %d\n', num_triangles);
fprintf(' Total Edges           : %d (Internal: %d, Boundary: %d)\n', ...
num_edges, num_interior_edges, num_boundary_edges);
fprintf(' Theoretical Plate Area: %.6f m^2\n', exact_area);
fprintf(' Integrated Mesh Area  : %.6f m^2\n', total_calc_area);
fprintf(' Area Discrepancy      : %.4e %%\n', area_error_pct);
fprintf(' Mean Patch Area       : %.6f m^2\n', mean(patch_areas));
fprintf(' Mean Aspect Ratio     : %.3f (Min: %.3f, Max: %.3f)\n', ...
mean(aspect_ratios), min(aspect_ratios), max(aspect_ratios));
fprintf(' Min Interior Angle    : %.2f deg\n', min(min_angles));
fprintf('=======================================================\n');
